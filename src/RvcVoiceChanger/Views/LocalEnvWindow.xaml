<Window x:Class="RvcVoiceChanger.Views.LocalEnvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пакеты из другого Python"
        Height="600" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="Взять готовые пакеты с диска" />

        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Если на компьютере уже стоит Python с torch, пакеты можно скопировать вместо скачивания. Сборка torch с CUDA весит больше двух гигабайт, копирование с диска занимает пару минут. Подходят только окружения Python 3.11 — двоичные части пакетов привязаны к версии Python." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ScanButton" Content="Искать автоматически" Click="Scan_Click" />
            <Button x:Name="PickButton" Content="Указать папку site-packages..." Click="Pick_Click" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ListBox Grid.Row="3" x:Name="EnvList" SelectionChanged="Env_Changed"
                 Background="{DynamicResource CardBg}" Foreground="{DynamicResource Fg}" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4,2,4">
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        <TextBlock Text="{Binding SitePackages}" Foreground="{DynamicResource Muted}" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBox Grid.Row="4" x:Name="ImportLog" Height="130" Margin="0,10,0,0" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="{DynamicResource ConsoleBg}" Foreground="{DynamicResource ConsoleFg}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="Закрыть" Click="Close_Click" />
            <Button x:Name="ImportButton" Content="Перенести пакеты" IsEnabled="False"
                    Style="{StaticResource AccentButton}" Click="Import_Click" />
        </StackPanel>
    </Grid>
</Window>
