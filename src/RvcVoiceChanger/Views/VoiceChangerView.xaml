<UserControl x:Class="RvcVoiceChanger.Views.VoiceChangerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="Изменение голоса в реальном времени" />

            <GroupBox Grid.Row="1" Header="Модель и тон">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Голос:" Width="150" />
                        <ComboBox x:Name="ModelBox" Width="380" DisplayMemberPath="Name"
                                  SelectionChanged="Model_Changed" />
                        <TextBlock x:Name="ModelInfo" Margin="12,0,0,0" Foreground="{DynamicResource Muted}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Высота тона:" Width="150" />
                        <Slider x:Name="PitchSlider" Width="380" Minimum="-24" Maximum="24"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Pitch_Changed" />
                        <TextBlock x:Name="PitchText" Width="60" Margin="12,0,0,0" />
                        <Button Content="Муж → Жен (+12)" Click="PitchUp_Click" />
                        <Button Content="Жен → Муж (-12)" Click="PitchDown_Click" />
                        <Button Content="0" Click="PitchReset_Click" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Аудиоустройства">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Микрофон:" Width="150" />
                        <ComboBox x:Name="InputBox" Width="420" DisplayMemberPath="Display"
                                  SelectionChanged="Device_Changed" />
                        <TextBlock Text="Усиление:" Margin="16,0,8,0" />
                        <Slider x:Name="InGain" Width="120" Minimum="-20" Maximum="20" ValueChanged="Gain_Changed" />
                        <TextBlock x:Name="InGainText" Width="60" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Вывод (вирт. микрофон):" Width="150" />
                        <ComboBox x:Name="OutputBox" Width="420" DisplayMemberPath="Display"
                                  SelectionChanged="Device_Changed" />
                        <TextBlock Text="Усиление:" Margin="16,0,8,0" />
                        <Slider x:Name="OutGain" Width="120" Minimum="-20" Maximum="20" ValueChanged="Gain_Changed" />
                        <TextBlock x:Name="OutGainText" Width="60" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Самопрослушка:" Width="150" />
                        <ComboBox x:Name="MonitorBox" Width="420" DisplayMemberPath="Display"
                                  SelectionChanged="Device_Changed" />
                        <CheckBox x:Name="MonitorEnabled" Content="Слышать себя в наушниках" Margin="16,0,0,0"
                                  Checked="Device_Changed" Unchecked="Device_Changed" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Обновить список" Click="RefreshDevices_Click" />
                        <Button x:Name="CableButton" Content="Установить виртуальный микрофон (VB-CABLE)" Click="InstallCable_Click" />
                        <TextBlock x:Name="CableStatus" Foreground="{DynamicResource Muted}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="В Discord / OBS / игре выберите микрофон &quot;CABLE Output (VB-Audio Virtual Cable)&quot; — туда попадаёт изменённый голос." />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Управление">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="Старт" Style="{StaticResource AccentButton}"
                                Width="140" Click="Start_Click" />
                        <Button x:Name="StopButton" Content="Стоп" Width="120" IsEnabled="False" Click="Stop_Click" />
                        <Button x:Name="TestButton" Content="Проверка (говорите и слушайте)" Click="Test_Click" />
                        <TextBlock x:Name="StatusText" Margin="12,0,0,0" Foreground="{DynamicResource Muted}" />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Уровень входа" />
                        <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="InputMeter" Height="10" Maximum="1"
                                     Margin="0,0,0,8" Foreground="{DynamicResource Ok}"
                                     Background="{DynamicResource Bg3}" BorderThickness="0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Уровень выхода" />
                        <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="OutputMeter" Height="10" Maximum="1"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource Bg3}" BorderThickness="0" />
                    </Grid>

                    <TextBlock x:Name="LatencyText" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                </StackPanel>
            </GroupBox>

            <TextBlock Grid.Row="4" Style="{StaticResource Hint}"
                       Text="Если звук рвётся — увеличьте размер чанка во вкладке «Настройки»; чем больше чанк, тем выше задержка, но стабильнее звук." />
        </Grid>
    </ScrollViewer>
</UserControl>
