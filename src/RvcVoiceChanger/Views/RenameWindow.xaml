<Window x:Class="RvcVoiceChanger.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Имя модели" Width="470" MinWidth="470" MinHeight="200"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <StackPanel Margin="20">
        <TextBlock Text="Введите своё название модели:" Margin="0,0,0,10" />
        <TextBox x:Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Отмена" MinWidth="110" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Сохранить" MinWidth="110" Margin="0"
                    Style="{StaticResource AccentButton}" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
