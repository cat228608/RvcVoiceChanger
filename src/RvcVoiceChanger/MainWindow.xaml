<Window x:Class="RvcVoiceChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RVC Voice Changer" Height="820" Width="1320"
        MinHeight="660" MinWidth="1160"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая навигация -->
        <Border Grid.Column="0" Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,14">
                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,18">
                    <TextBlock FontWeight="Bold" FontSize="15" Text="🎤 RVC Voice Changer" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,10,12,0">
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="EngineDot" Width="8" Height="8"
                                         Fill="{DynamicResource Muted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="EngineBadge" Text="Остановлено" Margin="7,0,0,0" FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceBadge" Style="{StaticResource Hint}" Margin="15,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ThemeButton" Content="☀ Светлая тема" Margin="0"
                            HorizontalAlignment="Stretch" Click="ThemeToggle_Click" />
                </StackPanel>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         SelectedIndex="0" SelectionChanged="Nav_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Margin="10,2">
                                            <Border x:Name="B" Background="Transparent" CornerRadius="8"
                                                    Padding="12,9" SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="Indicator" Width="3" CornerRadius="2"
                                                    HorizontalAlignment="Left" Margin="1,8"
                                                    Background="{DynamicResource Accent}" Visibility="Collapsed" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BgHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SelBg}" />
                                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem Content="🎙 Изменение голоса" />
                    <ListBoxItem Content="📦 Модели" />
                    <ListBoxItem Content="🔎 Парсер моделей" />
                    <ListBoxItem Content="⚙ Настройки" />
                    <ListBoxItem Content="📋 Логи" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Контент -->
        <ContentControl Grid.Column="1" x:Name="Host" Margin="0" />
    </Grid>
</Window>
